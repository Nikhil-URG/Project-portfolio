---
import { SITE, SOCIAL_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="mt-28 border-t border-ink/80">
  <div class="mx-auto w-full max-w-(--container-page) px-5 sm:px-8">
    <div class="flex flex-col gap-6 py-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-display text-sm font-medium">{SITE.name}</p>
        <p class="mono-label mt-1.5 text-ink-muted">
          {SITE.role}
        </p>
      </div>
      <ul class="flex items-center gap-6">
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="mono-label text-ink-soft transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="flex items-center justify-between border-t border-line py-4">
      <p class="mono-label text-ink-muted">© {year} · Bonn, DE</p>
      <p class="mono-label text-ink-muted" aria-hidden="true">50.73°N / 7.10°E</p>
    </div>
  </div>
</footer>
