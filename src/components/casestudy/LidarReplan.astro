---
---

<div class="blueprint overflow-x-auto border border-line-strong/80">
  <svg
    class="block w-full min-w-[640px] text-ink"
    viewBox="0 0 760 320"
    role="img"
    aria-label="Top-down lidar obstacle avoidance: a 270 degree scan around the drone detects an obstacle at 3.75 metres, a lateral detour is flown, then the original waypoint is reached"
  >
    <defs>
      <marker id="lr-arr" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
        <path d="M0 0L7 3.5L0 7" fill="var(--color-accent)"></path>
      </marker>
    </defs>

    <text x="20" y="22" font-family="var(--font-mono)" font-size="9" letter-spacing="0.12em" fill="var(--color-ink-muted)">
      TOP-DOWN · REACTIVE REPLAN
    </text>
    <text x="740" y="22" text-anchor="end" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      270° lidar · 30 Hz · 10° sectors
    </text>

    <!-- scan arc -->
    <path
      d="M133 43 A165 165 0 1 1 367 277"
      fill="none"
      stroke="var(--color-line-strong)"
      stroke-width="1"
      stroke-dasharray="3 5"
    ></path>

    <!-- forward corridor -->
    <g stroke="var(--color-accent)" stroke-width="0.75" stroke-dasharray="3 4" opacity="0.6">
      <line x1="250" y1="160" x2="470" y2="33"></line>
      <line x1="250" y1="160" x2="470" y2="287"></line>
    </g>
    <text x="430" y="44" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      corridor check ±30°
    </text>

    <!-- original path -->
    <line x1="250" y1="160" x2="650" y2="160" stroke="var(--color-ink-muted)" stroke-width="1" stroke-dasharray="3 4"></line>

    <!-- detour path -->
    <path d="M250 160 L360 76 L640 160" fill="none" stroke="var(--color-accent)" stroke-width="1.6" marker-end="url(#lr-arr)"></path>

    <!-- lateral offset -->
    <line x1="360" y1="160" x2="360" y2="80" stroke="var(--color-accent-ink)" stroke-width="1" stroke-dasharray="3 3"></line>
    <text x="368" y="120" font-family="var(--font-mono)" font-size="8" fill="var(--color-accent-ink)">
      2.5 m lateral
    </text>

    <!-- range bracket -->
    <g stroke="var(--color-line-strong)" stroke-width="1">
      <line x1="250" y1="188" x2="360" y2="188"></line>
      <line x1="250" y1="184" x2="250" y2="192"></line>
      <line x1="360" y1="184" x2="360" y2="192"></line>
    </g>
    <text x="305" y="202" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      3.75 m
    </text>

    <!-- drone -->
    <g>
      <circle cx="250" cy="160" r="4" fill="var(--color-accent)"></circle>
      <g stroke="var(--color-ink)" stroke-width="1">
        <line x1="250" y1="150" x2="250" y2="170"></line>
        <line x1="240" y1="160" x2="260" y2="160"></line>
      </g>
      <g fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="0.9">
        <circle cx="239" cy="149" r="4"></circle>
        <circle cx="261" cy="149" r="4"></circle>
        <circle cx="239" cy="171" r="4"></circle>
        <circle cx="261" cy="171" r="4"></circle>
      </g>
    </g>
    <text x="250" y="226" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      current pose
    </text>

    <!-- obstacle -->
    <rect x="351" y="151" width="18" height="18" fill="var(--color-ink)" opacity="0.22" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <text x="360" y="142" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-ink)">
      obstacle
    </text>
    <text x="360" y="238" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      bearing −0.204 rad
    </text>

    <!-- detour point -->
    <circle cx="360" cy="76" r="4" fill="var(--color-paper)" stroke="var(--color-accent)" stroke-width="1.5"></circle>
    <text x="372" y="66" font-family="var(--font-mono)" font-size="8" fill="var(--color-accent-ink)">
      detour (1.54, 1.94, −5.0)
    </text>

    <!-- waypoint -->
    <circle cx="650" cy="160" r="7" fill="none" stroke="var(--color-accent)" stroke-width="1.3"></circle>
    <circle cx="650" cy="160" r="2.5" fill="var(--color-accent)"></circle>
    <text x="650" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-ink)">
      wp_02
    </text>

    <text x="20" y="306" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      2D lidar · 1080 samples · obstacle inside 4 m forward corridor.
    </text>
    <text x="740" y="306" text-anchor="end" font-family="var(--font-mono)" font-size="8" fill="var(--color-accent-ink)">
      1 replan · original waypoint reached · +1.9 s
    </text>
  </svg>
</div>
<p class="mono-label mt-3 text-accent md:hidden">scroll to explore →</p>
