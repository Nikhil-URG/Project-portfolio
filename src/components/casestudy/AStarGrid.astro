---
const cell = 26;
const cols = 13;
const rows = 6;
const ox = 60;
const oy = 34;

const obstacles = new Set([
  "3,0", "3,1", "3,2",
  "7,1", "7,2", "7,3",
  "10,2", "10,3", "10,4",
  "5,4", "6,4",
]);

const start = "0,1";
const goal = "12,2";

const path = [
  "0,1", "1,1", "2,1", "2,2", "2,3", "3,3", "4,3", "4,2", "4,1",
  "5,1", "6,1", "6,0", "7,0", "8,0", "8,1", "9,1", "10,1", "11,1", "11,2", "12,2",
];
---

<svg
  class="block w-full text-ink"
  viewBox={`0 0 ${ox * 2 + cols * cell} ${oy * 2 + rows * cell + 18}`}
  role="img"
  aria-label="A* search over an occupancy grid: start cell to goal cell around obstacles"
>
  {
    Array.from({ length: rows }).map((_, r) =>
      Array.from({ length: cols }).map((_, c) => {
        const key = `${c},${r}`;
        return (
          <rect
            x={ox + c * cell}
            y={oy + r * cell}
            width={cell}
            height={cell}
            fill={obstacles.has(key) ? "var(--color-line-strong)" : "transparent"}
            stroke="var(--color-line)"
            stroke-width="0.75"
          />
        );
      })
    )
  }
  {
    path.filter((k) => k !== start && k !== goal).map((k) => {
      const [c, r] = k.split(",").map(Number);
      return (
        <rect
          x={ox + c * cell + 5}
          y={oy + r * cell + 5}
          width={cell - 10}
          height={cell - 10}
          fill="none"
          stroke="var(--color-accent)"
          stroke-width="1.5"
        />
      );
    })
  }

  <rect x={ox} y={oy + cell + 4} width={cell - 8} height={cell - 8} fill="var(--color-ink)"></rect>
  <rect x={ox + 12 * cell + 4} y={oy + 2 * cell + 4} width={cell - 8} height={cell - 8} fill="none" stroke="var(--color-accent)" stroke-width="2"></rect>

  <g font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-muted)">
    <text x={ox - 8} y={oy + cell + 18}>start</text>
    <text x={ox + 12 * cell + 2} y={oy + 2 * cell + 18}>goal</text>
    <text x={ox + 3 * cell + 10} y={oy + 8}>occupied cells</text>
    <text x={ox + 8 * cell} y={oy + rows * cell + 12}>f(n) = g(n) + h(n)</text>
  </g>
</svg>
