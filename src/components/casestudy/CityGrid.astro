---
const cell = 38;
const gx = 52;
const gy = 32;
const pathPoints = [
  [0, 0], [1, 1], [2, 1], [3, 1], [4, 1],
  [4, 2], [4, 3], [4, 4],
  [5, 4], [6, 4], [7, 4],
  [7, 5], [7, 6], [7, 7],
  [8, 7], [9, 7], [10, 7],
  [10, 8], [10, 9], [10, 10],
] as const;

const center = (x: number, y: number) => ({
  cx: gx + y * cell + cell / 2,
  cy: gy + (10 - x) * cell + cell / 2,
});

const pathD = pathPoints
  .map(([x, y], i) => {
    const { cx, cy } = center(x, y);
    return `${i === 0 ? "M" : "L"}${cx} ${cy}`;
  })
  .join(" ");

const buildings = [
  { x: 2, y: 2, h: "10 m" },
  { x: 2, y: 5, h: "12 m" },
  { x: 2, y: 8, h: "14 m" },
  { x: 5, y: 2, h: "16 m" },
  { x: 5, y: 5, h: "10 m" },
  { x: 5, y: 8, h: "12 m" },
  { x: 8, y: 2, h: "14 m" },
  { x: 8, y: 5, h: "16 m" },
  { x: 8, y: 8, h: "12 m" },
];

const start = center(0, 0);
const goal = center(10, 10);
---

<div class="blueprint overflow-x-auto border border-line-strong/80">
  <svg
    class="block w-full min-w-[640px] text-ink"
    viewBox="0 0 760 485"
    role="img"
    aria-label="AERIS city grid: an 11 by 11 map with nine buildings and an A* path of 20 cells from start at 0,0 to goal at 10,10"
  >
    <text x="20" y="26" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      x / north ↑
    </text>
    <text x="470" y="480" text-anchor="end" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      y / east →
    </text>

    <!-- grid -->
    <g stroke="var(--color-line)" stroke-width="0.7">
      {Array.from({ length: 12 }).map((_, i) => (
        <line x1={gx + i * cell} y1={gy} x2={gx + i * cell} y2={gy + 11 * cell}></line>
      ))}
      {Array.from({ length: 12 }).map((_, i) => (
        <line x1={gx} y1={gy + i * cell} x2={gx + 11 * cell} y2={gy + i * cell}></line>
      ))}
    </g>

    <!-- buildings -->
    <g>
      {buildings.map((b) => {
        const left = gx + b.y * cell;
        const top = gy + (11 - b.x - 2) * cell;
        return (
          <g>
            <rect
              x={left}
              y={top}
              width={2 * cell}
              height={2 * cell}
              fill="var(--color-ink)"
              opacity="0.14"
              stroke="var(--color-line-strong)"
              stroke-width="1"
            ></rect>
            <text
              x={left + cell}
              y={top + cell + 3}
              text-anchor="middle"
              font-family="var(--font-mono)"
              font-size="8.5"
              fill="var(--color-ink-soft)"
            >
              {b.h}
            </text>
          </g>
        );
      })}
    </g>

    <!-- A* path -->
    <path d={pathD} fill="none" stroke="var(--color-accent)" stroke-width="7" stroke-opacity="0.14" stroke-linejoin="round" stroke-linecap="round"></path>
    <path d={pathD} fill="none" stroke="var(--color-accent)" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"></path>

    <!-- start / goal -->
    <circle cx={start.cx} cy={start.cy} r="5" fill="var(--color-paper)" stroke="var(--color-accent)" stroke-width="1.4"></circle>
    <circle cx={start.cx} cy={start.cy} r="2" fill="var(--color-accent)"></circle>
    <text x={start.cx} y={start.cy + 18} text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-accent-ink)">
      S
    </text>

    <circle cx={goal.cx} cy={goal.cy} r="6" fill="var(--color-paper)" stroke="var(--color-accent)" stroke-width="1.4"></circle>
    <circle cx={goal.cx} cy={goal.cy} r="2" fill="var(--color-accent)"></circle>
    <text x={goal.cx} y={goal.cy - 14} text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-accent-ink)">
      G
    </text>

    <!-- axes -->
    <g font-family="var(--font-mono)" font-size="7" fill="var(--color-ink-muted)">
      {Array.from({ length: 11 }).map((_, i) => (
        <text x={gx - 10} y={gy + (10 - i) * cell + cell / 2 + 2.5} text-anchor="end">
          {i}
        </text>
      ))}
      {Array.from({ length: 11 }).map((_, i) => (
        <text x={gx + i * cell + cell / 2} y={gy + 11 * cell + 16} text-anchor="middle">
          {i}
        </text>
      ))}
    </g>

    <!-- info panel -->
    <rect x="492" y="32" width="248" height="418" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <g font-family="var(--font-mono)">
      <text x="508" y="56" font-size="9" letter-spacing="0.12em" fill="var(--color-accent)">
        CITY GRID
      </text>
      <text x="508" y="76" font-size="8.5" fill="var(--color-ink-soft)">
        11 × 11 cells · 4.0 m each
      </text>
      <line x1="508" y1="90" x2="724" y2="90" stroke="var(--color-line)" stroke-width="1"></line>

      <text x="508" y="112" font-size="8" letter-spacing="0.1em" fill="var(--color-ink-muted)">
        MAP
      </text>
      <text x="508" y="132" font-size="8.5" fill="var(--color-ink-soft)">buildings</text>
      <text x="724" y="132" text-anchor="end" font-size="8.5" fill="var(--color-ink)">9</text>
      <text x="508" y="150" font-size="8.5" fill="var(--color-ink-soft)">occupied / free</text>
      <text x="724" y="150" text-anchor="end" font-size="8.5" fill="var(--color-ink)">36 / 85</text>
      <text x="508" y="168" font-size="8.5" fill="var(--color-ink-soft)">cruise altitude</text>
      <text x="724" y="168" text-anchor="end" font-size="8.5" fill="var(--color-ink)">5.0 m</text>
      <line x1="508" y1="182" x2="724" y2="182" stroke="var(--color-line)" stroke-width="1"></line>

      <text x="508" y="204" font-size="8" letter-spacing="0.1em" fill="var(--color-ink-muted)">
        PLANNER
      </text>
      <text x="508" y="224" font-size="8.5" fill="var(--color-ink-soft)">A* · 8-connected</text>
      <text x="508" y="240" font-size="8.5" fill="var(--color-ink-soft)">euclidean heuristic</text>
      <text x="508" y="256" font-size="8.5" fill="var(--color-ink-soft)">no corner cutting</text>
      <line x1="508" y1="270" x2="724" y2="270" stroke="var(--color-line)" stroke-width="1"></line>

      <text x="508" y="292" font-size="8" letter-spacing="0.1em" fill="var(--color-ink-muted)">
        ROUTE
      </text>
      <text x="508" y="312" font-size="8.5" fill="var(--color-ink-soft)">path</text>
      <text x="724" y="312" text-anchor="end" font-size="8.5" fill="var(--color-ink)">20 cells</text>
      <text x="508" y="330" font-size="8.5" fill="var(--color-ink-soft)">length</text>
      <text x="724" y="330" text-anchor="end" font-size="8.5" fill="var(--color-ink)">77.7 m</text>
      <text x="508" y="348" font-size="8.5" fill="var(--color-ink-soft)">min clearance</text>
      <text x="724" y="348" text-anchor="end" font-size="8.5" fill="var(--color-ink)">2.500 m</text>
      <line x1="508" y1="362" x2="724" y2="362" stroke="var(--color-line)" stroke-width="1"></line>

      <text x="508" y="384" font-size="8" letter-spacing="0.1em" fill="var(--color-ink-muted)">
        MISSION
      </text>
      <text x="508" y="404" font-size="8.5" fill="var(--color-ink-soft)">click free cell</text>
      <text x="508" y="420" font-size="8.5" fill="var(--color-ink-soft)">fly → hold 3 s</text>
      <text x="508" y="436" font-size="8.5" fill="var(--color-ink-soft)">return → land</text>
    </g>
    <text x="724" y="462" text-anchor="end" font-family="var(--font-mono)" font-size="8" fill="var(--color-accent-ink)">
      dense-map SITL: 3/3 complete
    </text>
  </svg>
</div>
<p class="mono-label mt-3 text-accent md:hidden">scroll to explore →</p>
