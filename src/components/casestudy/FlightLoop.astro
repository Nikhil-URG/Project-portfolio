---
---

<div class="blueprint overflow-x-auto border border-line-strong/80">
  <svg
    class="block w-full min-w-[640px] text-ink"
    viewBox="0 0 760 280"
    role="img"
    aria-label="Offboard controller state machine: prestream, offboard, arm, takeoff, hold, transit, return to launch and land, with a 20 Hz setpoint stream and an abort path"
  >
    <defs>
      <marker id="fl-arr" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
        <path d="M0 0L7 3.5L0 7" fill="var(--color-ink-muted)"></path>
      </marker>
      <marker id="fl-arr-acc" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
        <path d="M0 0L7 3.5L0 7" fill="var(--color-accent)"></path>
      </marker>
    </defs>

    <text x="20" y="14" font-family="var(--font-mono)" font-size="8.5" letter-spacing="0.12em" fill="var(--color-ink-muted)">
      STARTUP + ARM
    </text>

    <g font-family="var(--font-mono)">
      <g>
        <rect x="20" y="24" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="32" y="42" font-size="7.5" fill="var(--color-accent)">01</text>
        <text x="50" y="44" font-size="9.5" fill="var(--color-ink)">PRESTREAM</text>
        <text x="32" y="62" font-size="8" fill="var(--color-ink-muted)">2 s heartbeat + hold setpoint</text>
      </g>
      <g>
        <rect x="205" y="24" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="217" y="42" font-size="7.5" fill="var(--color-accent)">02</text>
        <text x="235" y="44" font-size="9.5" fill="var(--color-ink)">OFFBOARD</text>
        <text x="217" y="62" font-size="8" fill="var(--color-ink-muted)">mode request, stream live</text>
      </g>
      <g>
        <rect x="390" y="24" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="402" y="42" font-size="7.5" fill="var(--color-accent)">03</text>
        <text x="420" y="44" font-size="9.5" fill="var(--color-ink)">ARM</text>
        <text x="402" y="62" font-size="8" fill="var(--color-ink-muted)">ACK-gated, no blind arming</text>
      </g>
      <g>
        <rect x="575" y="24" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="587" y="42" font-size="7.5" fill="var(--color-accent)">04</text>
        <text x="605" y="44" font-size="9.5" fill="var(--color-ink)">TAKEOFF</text>
        <text x="587" y="62" font-size="8" fill="var(--color-ink-muted)">ramp to −5 m NED</text>
      </g>
    </g>

    <g stroke="var(--color-ink-muted)" stroke-width="1" fill="none" marker-end="url(#fl-arr)">
      <line x1="185" y1="49" x2="201" y2="49"></line>
      <line x1="370" y1="49" x2="386" y2="49"></line>
      <line x1="555" y1="49" x2="571" y2="49"></line>
      <path d="M657 74 L657 102 L102 102 L102 120"></path>
      <line x1="185" y1="149" x2="201" y2="149"></line>
      <line x1="370" y1="149" x2="386" y2="149"></line>
      <line x1="555" y1="149" x2="571" y2="149"></line>
    </g>

    <text x="380" y="96" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      mission manager owns the waypoint sequence
    </text>

    <text x="220" y="118" font-family="var(--font-mono)" font-size="8.5" letter-spacing="0.12em" fill="var(--color-ink-muted)">
      MISSION + RETURN
    </text>

    <g font-family="var(--font-mono)">
      <g>
        <rect x="20" y="124" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="32" y="142" font-size="7.5" fill="var(--color-accent)">05</text>
        <text x="50" y="144" font-size="9.5" fill="var(--color-ink)">HOLD</text>
        <text x="32" y="162" font-size="8" fill="var(--color-ink-muted)">goal, land, RTL or new target</text>
      </g>
      <g>
        <rect x="205" y="124" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="217" y="142" font-size="7.5" fill="var(--color-accent)">06</text>
        <text x="235" y="144" font-size="9.5" fill="var(--color-ink)">TRANSIT</text>
        <text x="217" y="162" font-size="8" fill="var(--color-ink-muted)">go_to · 0.3 m tolerance</text>
      </g>
      <g>
        <rect x="390" y="124" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="402" y="142" font-size="7.5" fill="var(--color-accent)">07</text>
        <text x="420" y="144" font-size="9.5" fill="var(--color-ink)">RTL</text>
        <text x="402" y="162" font-size="8" fill="var(--color-ink-muted)">PX4 AUTO_RTL, stream stops</text>
      </g>
      <g>
        <rect x="575" y="124" width="165" height="50" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
        <text x="587" y="142" font-size="7.5" fill="var(--color-accent)">08</text>
        <text x="605" y="144" font-size="9.5" fill="var(--color-ink)">LAND</text>
        <text x="587" y="162" font-size="8" fill="var(--color-ink-muted)">NAV_LAND → DONE</text>
      </g>
    </g>

    <g font-family="var(--font-mono)">
      <rect x="20" y="200" width="360" height="44" fill="var(--color-paper-raised)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
      <text x="34" y="219" font-size="9" fill="var(--color-ink)">20 Hz setpoint stream</text>
      <text x="34" y="234" font-size="8" fill="var(--color-ink-muted)">/fmu/in/offboard_control_mode + /fmu/in/trajectory_setpoint</text>

      <rect x="400" y="200" width="340" height="44" fill="var(--color-paper)" stroke="var(--color-accent)" stroke-width="1.25" stroke-dasharray="4 3"></rect>
      <text x="414" y="219" font-size="9" fill="var(--color-accent-ink)">abort path — from any state</text>
      <text x="414" y="234" font-size="8" fill="var(--color-ink-muted)">land · RTL · hold through the same controller</text>
    </g>

    <text x="380" y="268" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      PX4 keeps EKF2, position and attitude control; AERIS never publishes actuator commands.
    </text>
  </svg>
</div>
<p class="mono-label mt-3 text-accent md:hidden">scroll to explore →</p>
