<svg
  class="block w-full text-ink"
  viewBox="0 0 720 210"
  role="img"
  aria-label="Potential fields: attraction toward the goal, repulsion from obstacles, composed into a steering vector"
>
  <defs>
    <marker id="fld-arr" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
      <path d="M0 0L7 3.5L0 7" fill="currentColor"></path>
    </marker>
  </defs>

  <g stroke="var(--color-line)" fill="none">
    <circle cx="470" cy="70" r="34" stroke-dasharray="3 4"></circle>
    <circle cx="470" cy="70" r="17"></circle>
    <circle cx="300" cy="160" r="24" stroke-dasharray="3 4"></circle>
    <circle cx="300" cy="160" r="12"></circle>
  </g>

  <g stroke="var(--color-ink-muted)" stroke-width="1" fill="none" marker-end="url(#fld-arr)">
    <line x1="228" y1="118" x2="266" y2="140"></line>
    <line x1="176" y1="146" x2="214" y2="158"></line>
  </g>

  <g stroke="var(--color-accent)" stroke-width="1.5" marker-end="url(#fld-arr)">
    <line x1="240" y1="110" x2="510" y2="64"></line>
  </g>

  <g font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-muted)">
    <text x="470" y="70" text-anchor="middle" fill="var(--color-accent)">goal</text>
    <text x="300" y="163" text-anchor="middle">obs</text>
    <text x="536" y="60">F_goal — attract</text>
    <text x="282" y="128">F_obs — repel</text>
    <text x="170" y="52">F_result</text>
  </g>

  <g transform="translate(240 110)">
    <rect x="-5" y="-5" width="10" height="10" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="1.25"></rect>
    <line x1="0" y1="0" x2="24" y2="-16" stroke="var(--color-ink)" stroke-width="1.25" marker-end="url(#fld-arr)"></line>
  </g>

  <text x="240" y="196" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-muted)" text-anchor="middle">
    steer = f(attract to goal, repel from obstacles) → /cmd_vel
  </text>
</svg>
