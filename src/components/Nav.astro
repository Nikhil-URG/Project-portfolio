---
import { NAV, SITE } from "../consts";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/work" ? path.startsWith("/work") : false;
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div
    class="mx-auto flex w-full max-w-(--container-page) flex-col gap-2 px-5 py-3 sm:h-14 sm:flex-row sm:items-center sm:justify-between sm:gap-0 sm:px-8 sm:py-0"
  >
    <a href="/" class="flex items-center gap-3 whitespace-nowrap">
      <span class="font-display text-sm font-semibold tracking-tight">
        {SITE.name}
      </span>
      <span class="hidden h-3 w-px bg-line-strong lg:block" aria-hidden="true"></span>
      <span class="mono-label hidden text-ink-muted lg:block" aria-hidden="true">
        Lab Notebook
      </span>
    </a>
    <div class="flex items-center gap-3 sm:gap-6">
      <nav aria-label="Main navigation" class="flex-1 sm:flex-none">
        <ul class="flex items-center justify-between gap-4 sm:justify-end sm:gap-8">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class="mono-label whitespace-nowrap text-ink-soft transition-colors duration-200 hover:text-accent aria-[current=page]:text-accent"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center text-ink-soft transition-colors duration-200 hover:text-accent"
      >
        <svg
          class="theme-icon-moon"
          width="15"
          height="15"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M8 2a4 4 0 0 0 6 6 6 6 0 1 1-6-6Z"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="theme-icon-sun"
          width="15"
          height="15"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.25"></circle>
          <path
            d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.41 1.41M11.54 11.54l1.41 1.41M12.95 3.05l-1.41 1.41M4.46 11.54l-1.41 1.41"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
