---
---

<div class="blueprint overflow-x-auto border border-line-strong/80">
  <svg
    class="block w-full min-w-[640px] text-ink"
    viewBox="0 0 760 410"
    role="img"
    aria-label="AERIS runtime layers: ROS 2 mission autonomy over uXRCE-DDS, PX4 flight control, and Gazebo simulation, with evidence logs and tests alongside"
  >
    <defs>
      <marker id="as-down" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
        <path d="M0 0L7 3.5L0 7" fill="var(--color-accent)"></path>
      </marker>
      <marker id="as-up" markerWidth="7" markerHeight="7" refX="1" refY="3.5" orient="auto">
        <path d="M7 0L0 3.5L7 7" fill="var(--color-ink-muted)"></path>
      </marker>
    </defs>

    <!-- mission autonomy -->
    <rect x="20" y="18" width="592" height="144" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <text x="32" y="38" font-family="var(--font-mono)" font-size="9.5" letter-spacing="0.12em" fill="var(--color-ink-muted)">
      MISSION AUTONOMY — ROS 2 JAZZY
    </text>

    <g font-family="var(--font-mono)">
      <g>
        <rect x="32" y="50" width="180" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
        <text x="44" y="68" font-size="9.5" fill="var(--color-ink)">aeris_flight_control</text>
        <text x="44" y="82" font-size="8" fill="var(--color-ink-muted)">C++ · offboard + PX4 I/O</text>
      </g>
      <g>
        <rect x="218" y="50" width="180" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
        <text x="230" y="68" font-size="9.5" fill="var(--color-ink)">aeris_mission_manager</text>
        <text x="230" y="82" font-size="8" fill="var(--color-ink-muted)">Py · mission state + JSONL</text>
      </g>
      <g>
        <rect x="404" y="50" width="180" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
        <text x="416" y="68" font-size="9.5" fill="var(--color-ink)">aeris_perception</text>
        <text x="416" y="82" font-size="8" fill="var(--color-ink-muted)">Py · camera + OpenCV</text>
      </g>
      <g>
        <rect x="32" y="98" width="180" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
        <text x="44" y="116" font-size="9.5" fill="var(--color-ink)">aeris_navigation</text>
        <text x="44" y="130" font-size="8" fill="var(--color-ink-muted)">C++ · lidar obstacles</text>
      </g>
      <g>
        <rect x="218" y="98" width="180" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
        <text x="230" y="116" font-size="9.5" fill="var(--color-ink)">aeris_safety</text>
        <text x="230" y="130" font-size="8" fill="var(--color-ink-muted)">C++ · monitors + failsafes</text>
      </g>
      <g>
        <rect x="404" y="98" width="180" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
        <text x="416" y="116" font-size="9.5" fill="var(--color-ink)">aeris_grid_navigation</text>
        <text x="416" y="130" font-size="8" fill="var(--color-ink-muted)">Py · A* + PyQt5 GUI</text>
      </g>
    </g>

    <!-- DDS boundary -->
    <rect x="20" y="176" width="592" height="38" fill="var(--color-paper-raised)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <text x="316" y="199" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-ink-soft)">
      uXRCE-DDS · px4_msgs · typed /fmu/in + /fmu/out
    </text>

    <!-- PX4 -->
    <rect x="20" y="228" width="592" height="72" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <text x="32" y="248" font-family="var(--font-mono)" font-size="9.5" letter-spacing="0.12em" fill="var(--color-ink-muted)">
      PX4 AUTOPILOT — STABILIZATION + ACTUATOR AUTHORITY
    </text>
    <g font-family="var(--font-mono)" font-size="8.5" fill="var(--color-ink-soft)" text-anchor="middle">
      <rect x="32" y="258" width="128" height="28" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="96" y="276">EKF2 estimator</text>
      <rect x="174" y="258" width="128" height="28" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="238" y="276">position loop</text>
      <rect x="316" y="258" width="128" height="28" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="380" y="276">attitude loop</text>
      <rect x="458" y="258" width="128" height="28" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="522" y="276">actuators</text>
    </g>

    <!-- Gazebo -->
    <rect x="20" y="314" width="592" height="78" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <text x="32" y="334" font-family="var(--font-mono)" font-size="9.5" letter-spacing="0.12em" fill="var(--color-ink-muted)">
      GAZEBO HARMONIC — WORLD + SENSORS
    </text>
    <text x="32" y="358" font-family="var(--font-mono)" font-size="9" fill="var(--color-ink-soft)">
      X500 airframe · physics · downward camera + 270° lidar · inspection targets · city grid
    </text>
    <text x="32" y="378" font-family="var(--font-mono)" font-size="8" fill="var(--color-accent-ink)">
      simulation boundary — all evidence in this project is SITL
    </text>

    <!-- layer connectors -->
    <g stroke-width="1" fill="none">
      <line x1="62" y1="162" x2="62" y2="175" stroke="var(--color-accent)" marker-end="url(#as-down)"></line>
      <line x1="570" y1="176" x2="570" y2="163" stroke="var(--color-ink-muted)" marker-end="url(#as-up)"></line>
      <line x1="62" y1="214" x2="62" y2="227" stroke="var(--color-accent)" marker-end="url(#as-down)"></line>
      <line x1="570" y1="228" x2="570" y2="215" stroke="var(--color-ink-muted)" marker-end="url(#as-up)"></line>
      <line x1="62" y1="300" x2="62" y2="313" stroke="var(--color-accent)" marker-end="url(#as-down)"></line>
      <line x1="570" y1="314" x2="570" y2="301" stroke="var(--color-ink-muted)" marker-end="url(#as-up)"></line>
    </g>

    <!-- evidence rail -->
    <rect x="628" y="18" width="112" height="374" fill="var(--color-paper)" stroke="var(--color-line-strong)" stroke-width="1"></rect>
    <text x="684" y="38" text-anchor="middle" font-family="var(--font-mono)" font-size="9" letter-spacing="0.14em" fill="var(--color-accent)">
      EVIDENCE
    </text>
    <g font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-soft)" text-anchor="middle">
      <rect x="636" y="52" width="96" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="684" y="69">JSONL mission logs</text>
      <text x="684" y="83" fill="var(--color-ink-muted)">every run</text>

      <rect x="636" y="104" width="96" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="684" y="121">benchmark</text>
      <text x="684" y="135" fill="var(--color-ink-muted)">JSON + CSV</text>

      <rect x="636" y="156" width="96" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="684" y="173">46 automated</text>
      <text x="684" y="187" fill="var(--color-ink-muted)">tests passing</text>

      <rect x="636" y="208" width="96" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="684" y="225">20 environment</text>
      <text x="684" y="239" fill="var(--color-ink-muted)">checks</text>

      <rect x="636" y="260" width="96" height="42" fill="var(--color-paper-raised)" stroke="var(--color-line)" stroke-width="1"></rect>
      <text x="684" y="277">video + plots</text>
      <text x="684" y="291" fill="var(--color-ink-muted)">checked in</text>
    </g>
    <text x="684" y="334" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      evidence is
    </text>
    <text x="684" y="348" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-ink-muted)">
      a build artifact,
    </text>
    <text x="684" y="362" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-accent-ink)">
      not an anecdote.
    </text>
  </svg>
</div>
<p class="mono-label mt-3 text-accent md:hidden">scroll to explore →</p>
