---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Tag from "../components/Tag.astro";
import PerceptionPipeline from "../components/perception/PerceptionPipeline";

const hardProblems = [
  {
    label: "Annotation quality",
    body: "A model's ceiling is its labels. Boundary ambiguity, class-definition drift between annotators, rare classes that never get enough coverage — the label spec has to be treated like code, with agreement measured and disagreements sampled.",
    q: "Would two annotators draw the same boundary?",
  },
  {
    label: "Temporal consistency",
    body: "A label that flickers frame-to-frame injects noise at the source, downstream of any model. Consistency across time is a dataset property you engineer — audit clips, not just frames.",
    q: "Does frame N agree with frame N+1?",
  },
  {
    label: "Occlusion",
    body: "The hard case is not detecting an object — it is keeping its identity through disappearance and re-appearance. Track quality is judged where objects come back, not where they are first seen.",
    q: "Is this the same object it was two seconds ago?",
  },
  {
    label: "Dataset reproducibility",
    body: "Version data like code: pinned preprocessing, fixed splits, recorded configs. If a benchmark number cannot be regenerated from the repo, it is an anecdote.",
    q: "Can someone re-run this and get the same numbers?",
  },
  {
    label: "Model evaluation",
    body: "Aggregate metrics hide conditional failures. Evaluate per class, per lighting condition, per edge case — and always against a human baseline, so 'good' has a reference.",
    q: "Where does the model's judgement diverge from ours?",
  },
  {
    label: "Human-in-the-loop",
    body: "The strongest pipelines route model uncertainty back into the annotation queue: confidence thresholds, disagreement sampling, review passes. The loop is the product.",
    q: "Which samples does the model need humans to look at next?",
  },
];

const practice = [
  {
    tag: "LiDAR",
    title: "Geometric perception — Robile AMR",
    body: "Perception on the AMR is sensor-native: range readings on /scan feeding SLAM and an occupancy grid on /map. The engineering questions were data association and map consistency — the same discipline as vision, different modality.",
    href: "/work/robile-amr",
    hrefLabel: "Case study",
  },
  {
    tag: "Imitation learning",
    title: "Observations as world model — Desk Hero / SO101",
    body: "In ACT-based imitation, the camera observation is the policy's entire world model. Demonstration quality propagates straight into policy quality — which is why capture rigor is a perception problem.",
    href: "/work/desk-hero",
    hrefLabel: "Project",
  },
  {
    tag: "Sensor data",
    title: "Pipelines you can trust — Flexli Technologies",
    body: "IoT sensor streams out of warehouse robotics systems, with data engineering and analytics behind them. The lesson that transfers to vision: data that cannot be trusted upstream cannot be interpreted downstream.",
    href: null,
  },
  {
    tag: "NLP",
    title: "Evaluation honesty — RoBERTa autograder",
    body: "Fine-tuning and evaluating a transformer in PyTorch — and learning exactly where its judgement diverges from a human's. That error-triage discipline is the same one perception models demand.",
    href: "/work/roberta-autograder",
    hrefLabel: "Project",
  },
];

const ledger = [
  {
    claim: "LiDAR SLAM & occupancy-grid mapping",
    status: "hands-on",
    evidence: "Robile AMR case study",
    href: "/work/robile-amr",
  },
  {
    claim: "Sensor data pipelines & analytics",
    status: "hands-on",
    evidence: "Flexli Technologies",
    href: null,
  },
  {
    claim: "Model training & evaluation (PyTorch)",
    status: "hands-on",
    evidence: "RoBERTa autograder · Desk Hero (ACT)",
    href: null,
  },
  {
    claim: "Imitation-learning observation pipelines (LeRobot)",
    status: "hands-on",
    evidence: "Desk Hero / SO101",
    href: "/work/desk-hero",
  },
  {
    claim: "Image processing fundamentals (OpenCV)",
    status: "applied",
    evidence: "project work & coursework",
    href: null,
  },
  {
    claim: "Production segmentation & multi-object tracking",
    status: "studied",
    evidence: "concepts I design around — not claimed as implemented",
    href: null,
  },
];

const statusStyle: Record<string, string> = {
  "hands-on": "border-accent text-accent",
  applied: "border-line-strong text-ink-soft",
  studied: "border-dashed border-line-strong text-ink-muted",
};
---

<BaseLayout
  title="Perception"
  description="Perception engineering notebook: pixels → representation → objects → temporal information → action. Computer vision, OpenCV, PyTorch and real-world sensor data."
>
  <header class="max-w-(--container-prose)">
    <p class="mono-label flex flex-wrap items-center gap-3 text-ink-muted">
      <a href="/" class="transition-colors hover:text-accent">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-soft">perception</span>
    </p>
    <h1 class="mt-6 text-3xl tracking-tight sm:text-display" data-reveal>Perception</h1>

    <p class="mono-data mt-7 flex flex-wrap items-center gap-x-3 gap-y-2" data-reveal>
      <span class="text-ink">Pixels</span>
      <span class="text-accent" aria-hidden="true">→</span>
      <span class="text-ink">Representation</span>
      <span class="text-accent" aria-hidden="true">→</span>
      <span class="text-ink">Objects</span>
      <span class="text-accent" aria-hidden="true">→</span>
      <span class="text-ink">Temporal information</span>
      <span class="text-accent" aria-hidden="true">→</span>
      <span class="text-ink">Action</span>
    </p>

    <p class="mt-6 text-lg text-ink-soft" data-reveal>
      Perception is the layer where the world becomes data — and every
      engineering decision after it inherits that data's quality. This page
      is how I think about the pipeline: what breaks, what to measure, and
      where it shows up in my own work.
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal>
      <ul class="flex flex-wrap gap-1.5">
        <li><Tag label="Computer vision" /></li>
        <li><Tag label="OpenCV" /></li>
        <li><Tag label="PyTorch" /></li>
        <li><Tag label="Sensor data" /></li>
        <li><Tag label="ROS 2" /></li>
      </ul>
      <p class="mono-label text-ink-muted">deep dive</p>
    </div>
  </header>

  <Section index="01" title="The pipeline" kicker="Interactive" id="pipeline">
    <p class="max-w-prose text-ink-soft" data-reveal>
      One chain, seven stages. Each card is a stage of the perception
      pipeline — select it to see what happens there, how it fails in the
      real world, and the question I would ask before trusting it.
    </p>
    <div class="mt-10" data-reveal>
      <PerceptionPipeline client:visible />
    </div>
  </Section>

  <Section index="02" title="Grounded in practice" kicker="Where this is real" id="practice">
    <div class="border-b border-line">
      {
        practice.map((p) => (
          <div class="group grid gap-x-8 gap-y-2 border-t border-line py-6 sm:grid-cols-[9rem_1fr] sm:py-7">
            <span class="mono-label pt-1 text-ink-muted">{p.tag}</span>
            <div>
              <h3 class="text-lg tracking-tight sm:text-xl">
                {p.href ? (
                  <a href={p.href} class="transition-colors hover:text-accent">
                    {p.title} →
                  </a>
                ) : (
                  <span>{p.title}</span>
                )}
              </h3>
              <p class="mt-2 max-w-prose text-sm text-ink-soft sm:text-base">{p.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section index="03" title="The hard problems" kicker="Design around these" id="hard-problems">
    <div class="grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        hardProblems.map((h) => (
          <article class="border-t border-line pt-4" data-reveal>
            <h3 class="mono-label text-accent">{h.label}</h3>
            <p class="mt-3 max-w-prose font-body text-sm text-ink-soft sm:text-base">{h.body}</p>
            <p class="mt-3 mono-data text-ink-muted">
              <span class="text-accent">Q</span> — {h.q}
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section index="04" title="Claims ledger" kicker="Honest bookkeeping" id="ledger">
    <p class="max-w-prose text-ink-soft" data-reveal>
      What I have actually built versus what I have studied. A portfolio
      that blurs that line is worthless to the teams reading it.
    </p>
    <dl class="mt-8" data-reveal>
      {
        ledger.map((row) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 border-t border-line py-3.5 last:border-b">
            <dt class="mono-data w-72 shrink-0 text-ink">{row.claim}</dt>
            <dd class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <span class:list={["mono-label inline-flex items-center border px-2 py-1", statusStyle[row.status]]}>
                {row.status}
              </span>
              {row.href ? (
                <a href={row.href} class="mono-data text-ink-soft transition-colors hover:text-accent">
                  {row.evidence} →
                </a>
              ) : (
                <span class="mono-data text-ink-soft">{row.evidence}</span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <section class="mt-24 border-t border-ink/80 pt-8 sm:mt-32">
    <div class="max-w-prose">
      <p class="mono-label text-accent">Talk</p>
      <p class="mt-4 text-lg text-ink" data-reveal>
        If you're building perception systems that need to survive real-world
        data — annotation pipelines, tracking, evaluation — I'd like to hear
        about it.
      </p>
      <a href="mailto:hello@nikhilravi.dev" class="group mt-5 inline-flex items-baseline gap-3 text-xl tracking-tight sm:text-2xl">
        <span class="text-accent transition-colors group-hover:text-accent-ink">hello@nikhilravi.dev</span>
        <svg class="transition-transform duration-200 group-hover:translate-x-1" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
