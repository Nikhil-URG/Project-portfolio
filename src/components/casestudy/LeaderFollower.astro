---

<svg
  class="block w-full text-ink"
  viewBox="0 0 720 220"
  role="img"
  aria-label="Leader and follower arms: the operator moves the leader, the follower mirrors its joints"
>
  <defs>
    <marker id="lf-arr" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
      <path d="M0 0L7 3.5L0 7" fill="var(--color-ink-muted)"></path>
    </marker>
  </defs>

  <g font-family="var(--font-mono)" font-size="10" fill="var(--color-ink)">
    <text x="60" y="30" font-weight="600">Leader</text>
    <text x="60" y="44" fill="var(--color-ink-muted)" font-size="9">operator side</text>

    <text x="640" y="30" text-anchor="end">Follower</text>
    <text x="640" y="44" fill="var(--color-ink-muted)" font-size="9" text-anchor="end">execution side</text>
  </g>

  <g stroke="var(--color-ink)" stroke-width="1.25" fill="none">
    <line x1="60" y1="180" x2="60" y2="130"></line>
    <line x1="60" y1="130" x2="95" y2="105"></line>
    <circle cx="60" cy="130" r="3.5" fill="var(--color-paper)" stroke="var(--color-ink)"></circle>
    <circle cx="95" cy="105" r="3.5" fill="var(--color-paper)" stroke="var(--color-ink)"></circle>
  </g>
  <g stroke="var(--color-ink)" stroke-width="1.25" fill="var(--color-paper)">
    <line x1="95" y1="105" x2="120" y2="112"></line>
    <circle cx="126" cy="112" r="7"></circle>
  </g>

  <g stroke="var(--color-ink)" stroke-width="1.25" fill="none">
    <line x1="660" y1="180" x2="660" y2="130"></line>
    <line x1="660" y1="130" x2="615" y2="105"></line>
    <circle cx="660" cy="130" r="3.5" fill="var(--color-paper)" stroke="var(--color-ink)"></circle>
    <circle cx="615" cy="105" r="3.5" fill="var(--color-paper)" stroke="var(--color-ink)"></circle>
  </g>
  <g stroke="var(--color-ink)" stroke-width="1.25" fill="var(--color-paper)">
    <line x1="615" y1="105" x2="600" y2="112"></line>
    <circle cx="594" cy="112" r="3.5"></circle>
  </g>

  <g stroke="var(--color-line-strong)" stroke-width="1" class="flow-edge">
    <line x1="140" y1="112" x2="580" y2="112"></line>
  </g>
  <text x="360" y="100" font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-muted)" text-anchor="middle">
    mirrored joints — step by step
  </text>

  <g font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-muted)">
    <text x="60" y="64">joint encoders</text>
    <text x="640" y="64" text-anchor="end">motors</text>
  </g>

  <g stroke="var(--color-line)">
    <line x1="30" y1="196" x2="680" y2="196"></line>
  </g>
  <g font-family="var(--font-mono)" font-size="9.5" fill="var(--color-ink-muted)">
    <text x="60" y="214">human does the task —</text>
    <text x="360" y="196" text-anchor="middle">teleoperation</text>
    <text x="680" y="196" text-anchor="end">the arm records it</text>
  </g>
</svg>
