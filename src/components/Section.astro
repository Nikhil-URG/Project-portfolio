---
interface Props {
  index?: string;
  title: string;
  kicker?: string;
  id?: string;
}

const { index, title, kicker, id } = Astro.props;
---

<section id={id} class="mt-24 sm:mt-32" data-reveal>
  <header class="relative mb-10 border-t border-ink/80 pt-3 sm:mb-14">
    <svg class="absolute -top-[5px] left-0 text-ink" width="9" height="9" viewBox="0 0 9 9" aria-hidden="true">
      <path d="M4.5 0V9M0 4.5H9" stroke="currentColor" stroke-width="1"></path>
    </svg>
    <svg class="absolute -top-[5px] right-0 text-ink" width="9" height="9" aria-hidden="true">
      <path d="M4.5 0V9M0 4.5H9" stroke="currentColor" stroke-width="1"></path>
    </svg>
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      {index && <span class="mono-label text-accent">{index}</span>}
      <h2 class="text-2xl tracking-tight sm:text-3xl">{title}</h2>
      {kicker && <span class="mono-label ml-auto text-ink-muted">{kicker}</span>}
    </div>
  </header>
  <slot />
</section>
